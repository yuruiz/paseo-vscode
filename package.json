{
  "name": "paseo-vscode",
  "version": "0.1.0",
  "private": true,
  "description": "Open a remote VS Code editor in a Paseo workspace tab.",
  "license": "Apache-2.0",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "runtime/secret-storage.js",
    "scripts/start.mjs",
    "scripts/fix-webview.mjs",
    "scripts/fix-secret-storage.mjs",
    "!**/*.test.*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.0-beta.1",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.43.0",
    "playwright": "^1.58.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
